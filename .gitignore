# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Self-signed certificate for the https e2e suite. Generated on first run by
# scripts/tls-dev.mjs; never committed.
.tls/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Scratch benchmark files, never committed.
_*.mts
_*.mjs

# Generated before every build from the current solver source. Never committed:
# a stale pruning table is not a slow solver but a wrong one, because the search
# trusts those numbers as lower bounds and prunes away the real solution.
.solver-cache/
