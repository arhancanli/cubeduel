{
  "name": "cubeduel",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "tables:build": "tsx scripts/build-solver-tables.mts",
    "demo:build": "tsx scripts/build-demo-solves.mts",
    "prebuild": "npm run tables:build && npm run demo:build",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts src/lib/auth/*.test.ts src/lib/solver/*.test.ts",
    "dailies": "node scripts/generate-dailies.mjs",
    "pool": "node scripts/generate-pool.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "e2e": "python3 e2e/a11y.py && python3 e2e/timer.py && python3 e2e/play.py && python3 e2e/train.py && python3 e2e/goal.py && python3 e2e/mobile.py && python3 e2e/ranked.py && python3 e2e/duel.py && python3 e2e/challenge.py && python3 e2e/rush.py && python3 e2e/auth.py && python3 e2e/recovery.py",
    "bench:solver": "tsx scripts/bench-solver.mts",
    "integration": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/integration-ranked.mts",
    "integration:challenges": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/integration-challenges.mts",
    "integration:rush": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/integration-rush.mts",
    "integration:passkeys": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/integration-passkeys.mts",
    "e2e:https": "NEXT_PUBLIC_SITE_URL=https://localhost:3443 npm run build && (NEXT_PUBLIC_SITE_URL=https://localhost:3443 npm run start & node scripts/tls-dev.mjs &) && sleep 10 && python3 e2e/https.py; code=$?; lsof -ti:3000,3443 | xargs kill -9 2>/dev/null; exit $code",
    "audit": "tsx scripts/audit.mts",
    "sweep": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/sweep.mts",
    "retention": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/retention.mts",
    "integration:accounts": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/integration-accounts.mts",
    "integration:events": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/integration-events.mts",
    "integration:profile-race": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/integration-profile-race.mts",
    "dailies:annotate": "tsx scripts/annotate-dailies.mts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.109.0",
    "cubing": "^0.56.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "license": "AGPL-3.0-only",
  "description": "A speedcubing platform with server-verified solves and a rating you can read in seconds.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arhancanli/cubeduel.git"
  }
}
