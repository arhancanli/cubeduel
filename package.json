{
  "name": "cubeduel",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "tables:build": "tsx scripts/build-solver-tables.mts",
    "prebuild": "npm run tables:build",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/lib/*.test.ts src/lib/solver/*.test.ts",
    "dailies": "node scripts/generate-dailies.mjs",
    "pool": "node scripts/generate-pool.mjs",
    "check:bundle": "node scripts/check-bundle.mjs",
    "e2e": "python3 e2e/a11y.py && python3 e2e/timer.py && python3 e2e/play.py && python3 e2e/train.py && python3 e2e/goal.py && python3 e2e/mobile.py && python3 e2e/ranked.py && python3 e2e/duel.py && python3 e2e/challenge.py",
    "bench:solver": "tsx scripts/bench-solver.mts",
    "integration": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/integration-ranked.mts",
    "integration:challenges": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/integration-challenges.mts",
    "integration:events": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/integration-events.mts",
    "integration:profile-race": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/integration-profile-race.mts",
    "dailies:annotate": "tsx scripts/annotate-dailies.mts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.7.3",
    "@supabase/supabase-js": "^2.109.0",
    "cubing": "^0.56.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "license": "AGPL-3.0-only",
  "description": "A speedcubing platform with server-verified solves and a rating you can read in seconds.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arhancanli/cubeduel.git"
  }
}
