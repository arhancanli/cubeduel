# Copy to `.env.local` and fill in. Never commit the filled-in version —
# `.gitignore` excludes `.env*` for exactly this reason.

# ---------------------------------------------------------------------------
# Supabase — the database, and with it identity. https://supabase.com/dashboard
# ---------------------------------------------------------------------------
# Apply everything in supabase/migrations/ to a fresh project first, in
# filename order — all of them, not just the first.
#
# There is no identity provider to configure. Accounts, sessions, passwords and
# passkeys are this application's own, in `users`, `sessions`, `credentials` and
# `webauthn_challenges`. See src/lib/auth/ — the whole of it is readable and
# nothing about it is rented.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# The SECRET key (`sb_secret_...`) or legacy `service_role` JWT — NOT the
# publishable/anon key. Every table has RLS on with no policies, so the
# publishable key is denied on every request: the app would look correctly
# configured and fail on all of them.
#
# This key bypasses row-level security. It is read only by server code
# (`src/lib/server/supabase.ts`, which is marked `server-only` so importing it
# from a client component fails the build rather than shipping the key).
SUPABASE_SECRET_KEY=sb_secret_xxx

# ---------------------------------------------------------------------------
# Resend — outgoing mail. Optional. https://resend.com
# ---------------------------------------------------------------------------
# Address confirmation, password reset, and the notices sent when a password
# changes or a passkey is added.
#
# Without it nothing is sent and the link is written to the server log instead,
# which is deliberate: the whole flow can be walked end to end on a laptop with
# no mail provider, no domain and no account. `email.ts` reports which of the
# two happened rather than returning a silent success, because a mail path that
# quietly does nothing is how a broken one reaches production.
#
# On a real deployment this is not optional in the sense that matters: without
# it, somebody who loses their passkey and forgets their password has no way
# back into their account.
RESEND_API_KEY=re_xxx

# Who mail comes from. Defaults to Resend's shared sender, which works with no
# domain verified at all — and shares its reputation with everyone else using
# it, so some mail will land in spam. Set this once there is a domain.
EMAIL_FROM=cubeduel <hello@your-domain.com>

# ---------------------------------------------------------------------------
# World Cube Association. Optional.
# https://www.worldcubeassociation.org/oauth/applications
# ---------------------------------------------------------------------------
# Lets a cuber prove they are a particular competitor, so their official
# competition results can be shown beside what they have done here.
#
# There is deliberately no way to type a WCA id in instead. Every WCA id is
# public — they are all on worldcubeassociation.org — so a text field would let
# anybody attach a world-class average to their profile, and the number beside
# their name would be a lie that looks exactly like the truth.
#
# So with these unset the feature is not offered at all, and the settings page
# says why. That is the correct failure: an unverifiable link is worse than no
# link.
#
# Register the application with the redirect URI <your site>/api/wca/callback
# and the `public` scope, which is the narrowest one that answers "who is this".
WCA_CLIENT_ID=
WCA_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Scheduled cleanup. Optional. Vercel Cron only.
# ---------------------------------------------------------------------------
# Authorises `/api/maintenance/sweep`, which removes expired sessions, spent
# passkey challenges, redeemed email links, old sign-in attempts and events past
# their retention window. Vercel sends this as a bearer token on every cron run.
#
# When it is unset the endpoint refuses EVERYTHING, which is the right default
# for something that deletes rows. Nothing is lost by leaving it unset: run
# `npm run sweep` instead, and every rule those rows are subject to is enforced
# on read anyway, so an unswept table is bigger rather than wrong.
CRON_SECRET=a-long-random-string

# ---------------------------------------------------------------------------
# The site's own address. Optional; Vercel supplies it automatically.
# ---------------------------------------------------------------------------
# Load-bearing for passkeys. WebAuthn binds every credential to a domain, and
# both the browser and this server check it — so a wrong value here does not
# degrade anything, it makes passkeys fail for everybody with an error about
# the origin. Set it only if the deployment is not on Vercel.
# NEXT_PUBLIC_SITE_URL=https://cubeduel.example
